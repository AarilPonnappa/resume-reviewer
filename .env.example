# Copy this file to .env and fill in your values. .env is git-ignored, never commit it.

# ---- Gemini (required unless every user pastes their own key in the app) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Any Gemini model your key can use, e.g. gemini-3.5-flash (default) or gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash

# ---- Database (optional; defaults to an H2 file database in ./data) ----
# DATABASE_URL=jdbc:postgresql://localhost:5432/resumeiq
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=

# ---- Email verification (optional; off by default) ----
EMAIL_VERIFICATION_ENABLED=false
# APP_BASE_URL=http://localhost:8080
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=you@gmail.com

# ---- Server ----
# PORT=8080
